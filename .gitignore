# ---------------------------------------------------------------
# Java build output
# ---------------------------------------------------------------
# Compiled classes (javac writes them next to the sources in Pacman/src)
*.class

# VS Code Java / Eclipse / IntelliJ / Gradle / Maven output folders
bin/
out/
build/
target/
.gradle/

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JVM crash logs, see https://docs.oracle.com/javase/8/docs/technotes/guides/troubleshoot/felogs.html
hs_err_pid*
replay_pid*

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# ---------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------
# VS Code: keep the shared project settings, ignore personal ones
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/launch.json
!**/.vscode/extensions.json

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Eclipse / NetBeans
.classpath
.project
.settings/
nbproject/private/

# Vim / Emacs swap and backup files
*.swp
*.swo
*~
\#*\#

# ---------------------------------------------------------------
# Operating system files
# ---------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
._*

# Linux
.directory
.Trash-*

# ---------------------------------------------------------------
# Web / tooling
# ---------------------------------------------------------------
node_modules/
npm-debug.log*

# ---------------------------------------------------------------
# Misc
# ---------------------------------------------------------------
*.log
*.tmp
*.bak
.env
